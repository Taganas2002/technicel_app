# Copy to .env on the Oracle VM. Never commit the real .env.

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

DB_NAME=technicel
DB_USERNAME=technicel
DB_PASSWORD=replace-with-a-long-db-password
DB_ROOT_PASSWORD=replace-with-a-long-root-password

# At least 32 characters. Do not use the local placeholder.
JWT_SECRET=replace-with-a-long-random-jwt-secret-32plus
JWT_EXPIRATION_MS=86400000

ADMIN_NIP=ADMIN001
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Admin
ADMIN_TECHNICIAN_CODE=ADMIN

# Comma-separated frontend URLs. Add your Cloudflare/Netlify URL after you create it.
CORS_ALLOWED_ORIGINS=http://localhost:5173
